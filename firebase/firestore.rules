rules_version = '2';
// Règles de sécurité Firestore de Trad Center.
// À copier dans : console Firebase → Firestore Database → Règles → Publier.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function pair(a, b) { return a < b ? a + '_' + b : b + '_' + a; }
    function areFriends(a, b) { return exists(/databases/$(db)/documents/friendships/$(pair(a, b))); }
    // Compte du serveur de notifications (GitHub Actions, scripts/notify.mjs)
    function isBot() { return signedIn() && request.auth.uid == 'akdK1tbiz1d0GaRxEzDZDaCX6Oo2'; }

    // Pseudo -> uid (pseudos uniques)
    match /usernames/{name} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.uid == me()
        && request.resource.data.keys().hasOnly(['uid'])
        && name.matches('^[a-z0-9_]{3,16}$');
      allow delete: if signedIn() && resource.data.uid == me();
    }

    // Profil public (pseudo, avatar, patrimoine, rang…)
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && uid == me()
        && request.resource.data.pseudoLower is string
        && getAfter(/databases/$(db)/documents/usernames/$(request.resource.data.pseudoLower)).data.uid == me();
      allow update: if signedIn() && uid == me()
        && request.resource.data.pseudoLower == resource.data.pseudoLower
        && request.resource.data.pseudo == resource.data.pseudo;
    }

    // Sauvegarde privée de la partie
    match /saves/{uid} {
      allow read, write: if signedIn() && uid == me();
    }

    // Demandes d'ami : id = <de>_<à>
    match /friendRequests/{id} {
      allow read: if signedIn() && (resource.data.from == me() || resource.data.to == me());
      allow create: if signedIn()
        && request.resource.data.from == me()
        && request.resource.data.to != me()
        && id == me() + '_' + request.resource.data.to;
      allow delete: if signedIn() && (resource.data.from == me() || resource.data.to == me());
    }

    // Amitiés : id = uids triés, créée par celui qui accepte une demande existante
    match /friendships/{id} {
      allow read: if signedIn() && me() in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.members.size() == 2
        && request.resource.data.members[1] == me()
        && id == pair(request.resource.data.members[0], me())
        && exists(/databases/$(db)/documents/friendRequests/$(request.resource.data.members[0] + '_' + me()));
      allow delete: if signedIn() && me() in resource.data.members;
    }

    // Envois d'argent / de crypto entre amis
    match /transfers/{id} {
      allow read: if signedIn() && (resource.data.from == me() || resource.data.to == me());
      allow create: if signedIn()
        && request.resource.data.from == me()
        && request.resource.data.to != me()
        && areFriends(me(), request.resource.data.to)
        && request.resource.data.claimed == false
        && request.resource.data.kind in ['cash', 'asset']
        && request.resource.data.eur is number && request.resource.data.eur > 0
        && request.resource.data.qty is number && request.resource.data.qty > 0;
      allow update: if signedIn()
        && resource.data.to == me()
        && resource.data.claimed == false
        && request.resource.data.claimed == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed', 'claimedAt']);
    }

    // Abonnements aux notifications push : id = <uid>_<appareil>
    match /pushSubs/{id} {
      allow read: if isBot() || (signedIn() && resource.data.uid == me());
      allow create, update: if signedIn()
        && request.resource.data.uid == me()
        && id.matches(me() + '_[a-z0-9]+');
      allow update: if isBot()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['alerts', 'lastPush']);
      allow delete: if isBot() || (signedIn() && resource.data.uid == me());
    }

    // Notifications à envoyer à un autre joueur (envoi d'argent, demande d'ami)
    match /pushQueue/{id} {
      allow create: if signedIn()
        && request.resource.data.from == me()
        && request.resource.data.to is string
        && request.resource.data.to != me()
        && (areFriends(me(), request.resource.data.to)
            || exists(/databases/$(db)/documents/friendRequests/$(me() + '_' + request.resource.data.to))
            || exists(/databases/$(db)/documents/friendships/$(pair(me(), request.resource.data.to))))
        && request.resource.data.title is string && request.resource.data.title.size() <= 100
        && request.resource.data.body is string && request.resource.data.body.size() <= 300;
      allow read, delete: if isBot();
    }

    // Mémoire du serveur de notifications (anti-doublons)
    match /pushState/{id} {
      allow read, write: if isBot();
    }
  }
}
